# Configuracion del backend Go. Migrada del .env de la raiz del repo original
# (bg-backend-go-test), que ademas compartian tools/ y los manifiestos de k8s.
# Aqui el backend va solo, asi que este fichero contiene unicamente lo suyo.
#
# Una variable de entorno real SIEMPRE gana al valor de este fichero (config.go),
# que es lo que permite que el Dockerfile imponga WS_PORT y WS_BIND_ADDRESS.
#
# El secreto es de prueba y esta versionado a proposito. En un entorno real este
# fichero sale del repositorio y el secreto viene de un gestor de secretos.

WS_JWT_SECRET=poc-websocket-shared-secret-change-me-min-32-bytes
WS_JWT_ISSUER=ws-poc-issuer
WS_JWT_AUDIENCE=ws-poc-clients

WS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

WS_MAX_MESSAGE_BYTES=65536
WS_RATE_LIMIT_PER_SEC=20
WS_MAX_CONNECTIONS=200
WS_IDLE_TIMEOUT_SECONDS=60

# Solo aplica al ejecutar en el host (go run .). Dentro del contenedor manda el
# WS_PORT=8080 que fija el Dockerfile.
WS_PORT_GO=8084

# --- Puente con el backend .NET 4.8 ----------------------------------------
# Vacio = modo inspeccion: los sobres {sesion, payload} se guardan en memoria y
# se consultan con GET /api/outbox, en vez de mandarse a ningun sitio.
WS_DOTNET_WEBHOOK_URL=
WS_DOTNET_TIMEOUT_SECONDS=5
WS_PUSH_RATE_LIMIT_PER_SEC=100
WS_OUTBOX_SIZE=200

# Vacio = entrega local, valida con UNA replica. Con varias hace falta Redis.
# Desde un contenedor, 127.0.0.1 no vale: usa el nombre del servicio de la red.
WS_REDIS_ADDR=


# una sesion de gananet
