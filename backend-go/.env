# Configuracion del servidor Go y de las herramientas de tools/.
#
# Este es el fichero que lee el servidor: start.ps1 arranca el binario con el
# working directory en backend-go/, y config.loadDotEnv sube desde el cwd y se
# queda con el PRIMER .env que encuentra. Una variable de entorno real siempre
# gana al valor de aqui.
#
# Antes habia un segundo .env en la raiz del repo con OTRO secreto, que era el
# que leian los scripts de tools/ y la coleccion de Postman: todo token generado
# fuera del servidor fallaba con 401 TOKEN_INVALID. Ahora hay uno solo.

WS_JWT_SECRET=_np0nYHlyPCNqiM0ZaYr71PH6IS36qgyGxX9clSdmiDzR5V-
WS_JWT_ISSUER=ws-poc-issuer
WS_JWT_AUDIENCE=ws-poc-clients

WS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

WS_MAX_MESSAGE_BYTES=65536
WS_RATE_LIMIT_PER_SEC=20
WS_MAX_CONNECTIONS=200
WS_IDLE_TIMEOUT_SECONDS=60

WS_PORT_GO=8084

# --- Puente con el backend .NET 4.8 ----------------------------------------
# La ruta del .NET a la que Go reenvia las peticiones del cliente y de la que
# ESPERA la respuesta, que baja luego por el WebSocket.
#
# Vacia = no hay a quien preguntar: una `peticion` responde BACKEND_UNAVAILABLE
# y el resto del canal (ping, echo) sigue funcionando.
WS_DOTNET_API_URL=http://127.0.0.1:9099/calcular
WS_DOTNET_TIMEOUT_SECONDS=5
# Tope de peticiones simultaneas contra el .NET. Sin el, 200 conexiones a 20
# msg/s son 4000 req/s contra un 4.8. Al llegar al tope se responde BACKEND_BUSY
# en vez de encolar sin limite.
WS_DOTNET_MAX_INFLIGHT=32
