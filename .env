# Configuración compartida por el servidor Go, las herramientas de tools/ y los
# manifiestos de k8s. Que todos lean el mismo fichero es lo que garantiza que
# hablen el mismo idioma (mismo secreto, mismo issuer, mismos límites).
#
# El servidor lee WS_PORT y, si no está, WS_PORT_GO. Una variable de entorno real
# siempre gana al valor de este fichero.
#
# El secreto de aquí es de prueba y está versionado a propósito. En un entorno
# real este fichero sale del repositorio y el secreto viene de un gestor de
# secretos.

WS_JWT_SECRET=poc-websocket-shared-secret-change-me-min-32-bytes
WS_JWT_ISSUER=ws-poc-issuer
WS_JWT_AUDIENCE=ws-poc-clients

WS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

WS_MAX_MESSAGE_BYTES=65536
WS_RATE_LIMIT_PER_SEC=20
WS_MAX_CONNECTIONS=200
WS_IDLE_TIMEOUT_SECONDS=60

WS_PORT_GO=8084

# --- Puente con el backend .NET 4.8 ----------------------------------------
# Vacio = modo inspeccion: los sobres {sesion, payload} que se le enviarian al
# .NET se guardan en memoria y se consultan con GET /api/outbox, en vez de
# mandarse a ningun sitio. En cuanto haya URL, se rellena aqui y empieza a
# enviarse de verdad, sin tocar codigo.
WS_DOTNET_WEBHOOK_URL=
WS_DOTNET_TIMEOUT_SECONDS=5
WS_PUSH_RATE_LIMIT_PER_SEC=100
WS_OUTBOX_SIZE=200

# Vacio = entrega local, valida con UNA replica. Con varias replicas hace falta
# Redis: la conexion vive en un solo proceso y un push puede caer en otro.
WS_REDIS_ADDR=
